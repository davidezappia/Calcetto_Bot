# --- Copia in .env e compila ---

# OBBLIGATORIO: token del bot ottenuto da @BotFather
BOT_TOKEN=123456789:AA-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Percorso del file SQLite. In Docker Compose e' su un volume montato su /data.
DB_PATH=/data/calcetto.sqlite3
# In alternativa un URL completo (per migrare a PostgreSQL, poi il resto non cambia):
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/calcetto

# Formato partita proposto in fase di /configura (poi salvato per-gruppo).
DEFAULT_REQUIRED_PLAYERS=10
DEFAULT_MATCH_DURATION_MIN=60

# Richiesta esito: quante ore dopo la FINE partita, e timeout prima di rinunciare.
OUTCOME_DELAY_HOURS=2
OUTCOME_TIMEOUT_HOURS=24

# Orario (Europe/Rome) del promemoria del giorno dopo la partita.
REMINDER_HOUR=10
REMINDER_MINUTE=0

LOG_LEVEL=INFO
